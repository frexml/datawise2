# Azure Container Apps "web" image — backend + frontend combined behind
# Caddy on a single port, per docs/azure-deploy-pattern.md. Local dev keeps
# using the plain `Dockerfile` (backend/worker only, bind-mount hot-reload) —
# this image is Azure-only and never touched by docker-compose.

FROM node:20-alpine AS frontend-build
WORKDIR /app

# Only copy package.json — NOT package-lock.json. The lock was generated on
# the host OS/arch and locks platform-specific native deps (Rollup) for that
# platform only. Fresh npm install inside the container picks the right ones.
COPY frontend/package.json ./
RUN npm install --legacy-peer-deps
COPY frontend/ ./
RUN npm run build


FROM python:3.12-slim AS backend-build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

COPY --from=ghcr.io/astral-sh/uv:0.5.7 /uv /uvx /usr/local/bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ ./src/
RUN uv sync --frozen --no-dev


FROM python:3.12-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends supervisor curl \
 && rm -rf /var/lib/apt/lists/*

# Grab the Caddy binary from its official image rather than adding an apt
# repo — fewer moving parts, same binary either way.
COPY --from=caddy:2-alpine /usr/bin/caddy /usr/bin/caddy

RUN useradd --create-home --uid 1000 app

ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/app

COPY --from=backend-build /opt/venv /opt/venv
COPY --from=backend-build /app/src /app/src
COPY --from=frontend-build /app/dist /app/frontend/dist

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY deploy/supervisord.conf /etc/supervisor/supervisord.conf

RUN chown -R app:app /app /home/app /etc/caddy \
 && mkdir -p /tmp/supervisor && chown app:app /tmp/supervisor

USER app
WORKDIR /app

EXPOSE 8080

CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf"]
