# OpenRouter API Configuration
# Copy this file to .env and fill in your API key. .env is gitignored.

# OpenRouter API Key (required for LLM enhancement)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Optional: Customize the model (default: openai/gpt-4o)
# Must use OpenRouter's provider-prefixed model IDs, e.g. openai/gpt-4o,
# anthropic/claude-sonnet-5
# OPENROUTER_MODEL=openai/gpt-4o

# Optional: Customize max tokens for responses (default: 150)
# OPENAI_MAX_TOKENS=150
