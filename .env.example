# OpenAI API Configuration
# Copy this file to .env and fill in your API key. .env is gitignored.

# OpenAI API Key (required for LLM enhancement)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Customize the model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: Customize max tokens for responses (default: 150)
# OPENAI_MAX_TOKENS=150
