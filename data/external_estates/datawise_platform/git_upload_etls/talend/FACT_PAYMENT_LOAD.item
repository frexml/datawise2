    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;DECLARE @alloc_mismatch INT, @gl_imbalance INT, @stale_unrecon INT;&#10;&#10;SELECT @alloc_mismatch = COUNT(*)&#10;FROM FACT.FACT_PAYMENT&#10;WHERE ABS(PrincipalAllocation + InterestAllocation + FeesAmount + PenaltyAmount - TotalAmount) > 0.01;&#10;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;VALUES (&#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;DQ_CHECK_ALLOCATION&apos;,&#10;    GETDATE(),&#10;    @alloc_mismatch,&#10;    CASE WHEN @alloc_mismatch > 0 THEN &apos;WARN_ALLOCATION_MISMATCH&apos; ELSE &apos;OK&apos; END&#10;);&#10;&#10;SELECT @gl_imbalance = COUNT(*)&#10;FROM FACT.FACT_GL&#10;WHERE ABS(DebitAmount - CreditAmount) > 0.01;&#10;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;VALUES (&#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;DQ_CHECK_GL_BALANCE&apos;,&#10;    GETDATE(),&#10;    @gl_imbalance,&#10;    CASE WHEN @gl_imbalance > 0 THEN &apos;WARN_GL_IMBALANCE&apos; ELSE &apos;OK&apos; END&#10;);&#10;&#10;SELECT @stale_unrecon = COUNT(*)&#10;FROM FACT.FACT_PAYMENT&#10;WHERE ReconStatus = &apos;UNRECONCILED&apos; &#10;AND ETL_LOAD_DT &lt; DATEADD(DAY, -1, GETDATE());&#10;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;VALUES (&#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;DQ_CHECK_STALE_UNRECON&apos;,&#10;    GETDATE(),&#10;    @stale_unrecon,&#10;    CASE WHEN @stale_unrecon > 0 THEN &apos;WARN_STALE_UNRECONCILED&apos; ELSE &apos;OK&apos; END&#10;);&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_12_DQ_CHECKS"/>
  </node>
