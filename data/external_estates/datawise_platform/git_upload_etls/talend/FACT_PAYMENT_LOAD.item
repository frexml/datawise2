    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="INSERT INTO MART.MART_FINANCE_SUMMARY (ReportDate,GLPeriod,BranchID,ProductID,TotalPaymentsReceived,TotalPrincipalCollected,TotalInterestIncome,TotalFeesIncome,TotalPenaltyIncome,TotalRevenue,TotalArrearsAmount,ArrearsRatio,NPLCount,NPLAmount,NPLRatio,ECL_Stage1_Amount,ECL_Stage2_Amount,ECL_Stage3_Amount,TotalProvision,ProvisionCoverageRatio,EarlyPaymentCount,PartialPaymentCount,LatePaymentCount,PaymentEfficiencyAvg,NIM,CostOfRisk,RevenueAtRisk,ETL_LOAD_DT,ETL_SOURCE)&#10;SELECT&#10;CAST(GETDATE() AS DATE),&#10;FORMAT(fp.GLPostingDate,&apos;yyyy-MM&apos;),&#10;b.BranchID,&#10;pr.ProductID,&#10;COUNT(*),&#10;SUM(fp.PrincipalAllocation),&#10;SUM(fp.InterestAllocation),&#10;SUM(fp.FeesAmount),&#10;SUM(fp.PenaltyAmount),&#10;SUM(fp.TotalAmount),&#10;SUM(fp.ArrearsAmount),&#10;SUM(fp.ArrearsAmount)/NULLIF(SUM(fl.LoanAmount),0),&#10;SUM(CAST(fp.NPLFlag AS INT)),&#10;SUM(CASE WHEN fp.NPLFlag=1 THEN fp.OutstandingBalanceAfter ELSE 0 END),&#10;SUM(CASE WHEN fp.NPLFlag=1 THEN fp.OutstandingBalanceAfter ELSE 0 END)/NULLIF(SUM(fp.OutstandingBalanceAfter),0),&#10;SUM(CASE WHEN fp.ECL_Stage=1 THEN fp.ECL_Amount ELSE 0 END),&#10;SUM(CASE WHEN fp.ECL_Stage=2 THEN fp.ECL_Amount ELSE 0 END),&#10;SUM(CASE WHEN fp.ECL_Stage=3 THEN fp.ECL_Amount ELSE 0 END),&#10;SUM(fp.ProvisionAmount),&#10;SUM(fp.ProvisionAmount)/NULLIF(SUM(CASE WHEN fp.NPLFlag=1 THEN fp.OutstandingBalanceAfter ELSE 0 END),0),&#10;SUM(CAST(fp.EarlyPaymentFlag AS INT)),&#10;SUM(CAST(fp.PartialPaymentFlag AS INT)),&#10;SUM(CAST(fp.IsLate AS INT)),&#10;AVG(fp.PaymentEfficiencyRatio),&#10;SUM(fp.InterestAllocation)/NULLIF(SUM(fp.OutstandingBalanceAfter),0),&#10;SUM(fp.ProvisionAmount)/NULLIF(SUM(fl.LoanAmount),0),&#10;SUM(CASE WHEN fp.WatchListFlag=1 OR fp.NPLFlag=1 THEN fp.TotalAmount ELSE 0 END),&#10;GETDATE(),&#10;&apos;FACT_PAYMENT_LOAD&apos;&#10;FROM FACT.FACT_PAYMENT fp&#10;INNER JOIN FACT.FACT_LOAN fl ON fp.LoanSK=fl.LoanFactSK&#10;INNER JOIN DIM.DIM_BRANCH b ON fp.BranchSK=b.BranchSK&#10;INNER JOIN DIM.DIM_PRODUCT pr ON fp.ProductSK=pr.ProductSK&#10;WHERE fp.GLPostingDate IS NOT NULL&#10;GROUP BY FORMAT(fp.GLPostingDate,&apos;yyyy-MM&apos;),b.BranchID,pr.ProductID&#10;HAVING NOT EXISTS (SELECT 1 FROM MART.MART_FINANCE_SUMMARY m WHERE m.ReportDate=CAST(GETDATE() AS DATE) AND m.GLPeriod=FORMAT(fp.GLPostingDate,&apos;yyyy-MM&apos;) AND m.BranchID=b.BranchID AND m.ProductID=pr.ProductID);&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG(BatchID,PackageName,StepName,StartTime,RowsProcessed,Status)&#10;VALUES(CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;FACT_PAYMENT_LOAD&apos;,&apos;LOAD_MART_FINANCE&apos;,GETDATE(),@@ROWCOUNT,&apos;OK&apos;);"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_11_LOAD_MART_FINANCE"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="768">
