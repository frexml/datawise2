  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="128" posY="160">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_2_VALIDATE_SOURCES"/>
    <elementParameter field="TEXT" name="LABEL" value="VALIDATE_SOURCES"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;DW_AUDIT&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.db_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.db_password"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value=""/>
    <elementParameter field="CHECK" name="USE_SHARED_CONNECTION" value="false"/>
    <elementParameter field="TEXT" name="SHARED_CONNECTION_NAME" value=""/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_DYNAMIC_JOB" value="false"/>
    <elementParameter field="TEXT" name="CONTEXT_JOB" value=""/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;DECLARE @pc INT, @lc INT;&#10;&#10;SELECT @pc = COUNT(*) FROM LOAN_SRC.LOAN_PAYMENT;&#10;SELECT @lc = COUNT(*) FROM FACT.FACT_LOAN;&#10;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;SELECT &#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;VALIDATE_SOURCES&apos;,&#10;    GETDATE(),&#10;    @pc,&#10;    CASE WHEN @pc = 0 THEN &apos;WARN_EMPTY&apos; ELSE &apos;OK&apos; END;&#10;&#10;IF @pc = 0&#10;    RAISERROR(&apos;LOAN_PAYMENT table is empty&apos;, 16, 1);&#10;&#10;IF @lc = 0&#10;    RAISERROR(&apos;FACT_LOAN table is empty&apos;, 16, 1);&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_2_VALIDATE_SOURCES"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="32" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_3_CREATE_FACT_PAYMENT"/>
    <elementParameter field="TEXT" name="LABEL" value="CREATE_FACT_PAYMENT"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;FACT&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.db_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.db_password"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value=""/>
    <elementParameter field="CHECK" name="USE_SHARED_CONNECTION" value="false"/>
    <elementParameter field="TEXT" name="SHARED_CONNECTION_NAME" value=""/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_DYNAMIC_JOB" value="false"/>
    <elementParameter field="TEXT" name="CONTEXT_JOB" value=""/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;IF NOT EXISTS (SELECT 1 FROM sys.objects WHERE object_id = OBJECT_ID(N&apos;FACT.FACT_PAYMENT&apos;) AND type = N&apos;U&apos;)&#10;BEGIN&#10;    CREATE TABLE FACT.FACT_PAYMENT (&#10;        PaymentSK INT IDENTITY(1,1) PRIMARY KEY,&#10;        PaymentID NVARCHAR(50) NOT NULL,&#10;        AccountID NVARCHAR(50) NOT NULL,&#10;        LoanSK INT NULL,&#10;        CustomerSK INT NULL,&#10;        BranchSK INT NULL,&#10;        ProductSK INT NULL,&#10;        PaymentDateSK INT NULL,&#10;        DueDateSK INT NULL,&#10;        PrincipalAmount DECIMAL(18,2) DEFAULT 0,&#10;        InterestAmount DECIMAL(18,2) DEFAULT 0,&#10;        FeesAmount DECIMAL(18,2) DEFAULT 0,&#10;        PenaltyAmount DECIMAL(18,2) DEFAULT 0,&#10;        TotalAmount DECIMAL(18,2) DEFAULT 0,&#10;        RunningBalance DECIMAL(18,2) DEFAULT 0,&#10;        OutstandingBalanceAfter DECIMAL(18,2) DEFAULT 0,&#10;        DaysPastDue INT DEFAULT 0,&#10;        DaysLate INT DEFAULT 0,&#10;        IsLate BIT DEFAULT 0,&#10;        ArrearsFlag BIT DEFAULT 0,&#10;        ArrearsAmount DECIMAL(18,2) DEFAULT 0,&#10;        ArrearsAgingBucket VARCHAR(20) NULL,&#10;        PaymentMethod NVARCHAR(50) NULL,&#10;        PaymentStatus NVARCHAR(50) NULL,&#10;        PaymentChannel NVARCHAR(50) NULL,&#10;        AllocationStatus NVARCHAR(50) NULL,&#10;        PrincipalAllocation DECIMAL(18,2) DEFAULT 0,&#10;        InterestAllocation DECIMAL(18,2) DEFAULT 0,&#10;        FeesAllocation DECIMAL(18,2) DEFAULT 0,&#10;        CumulativePrincipalPaid DECIMAL(18,2) DEFAULT 0,&#10;        CumulativeInterestPaid DECIMAL(18,2) DEFAULT 0,&#10;        RemainingPrincipal DECIMAL(18,2) DEFAULT 0,&#10;        RemainingTerm INT DEFAULT 0,&#10;        EarlyPaymentFlag BIT DEFAULT 0,&#10;        PartialPaymentFlag BIT DEFAULT 0,&#10;        PaymentEfficiencyRatio DECIMAL(8,4) DEFAULT 0,&#10;        NPLFlag BIT DEFAULT 0,&#10;        WatchListFlag BIT DEFAULT 0,&#10;        ProvisionAmount DECIMAL(18,2) DEFAULT 0,&#10;        ProvisionRate DECIMAL(8,4) DEFAULT 0,&#10;        ECL_Stage INT DEFAULT 1,&#10;        ECL_Amount DECIMAL(18,2) DEFAULT 0,&#10;        GLPostingStatus VARCHAR(20) DEFAULT &apos;PENDING&apos;,&#10;        GLJournalRef NVARCHAR(100) NULL,&#10;        GLPostingDate DATE NULL,&#10;        ReconStatus VARCHAR(20) DEFAULT &apos;UNRECONCILED&apos;,&#10;        ReconVariance DECIMAL(18,2) DEFAULT 0,&#10;        ETL_LOAD_DT DATETIME DEFAULT GETDATE(),&#10;        ETL_SOURCE NVARCHAR(100) DEFAULT &apos;LOAN_SRC.LOAN_PAYMENT&apos;,&#10;        BATCH_ID BIGINT NULL,&#10;        CONSTRAINT UQ_FACT_PAYMENT_ID UNIQUE(PaymentID),&#10;        CONSTRAINT FK_FP_Customer FOREIGN KEY(CustomerSK) REFERENCES DIM.DIM_CUSTOMER(CustomerSK),&#10;        CONSTRAINT FK_FP_Loan FOREIGN KEY(LoanSK) REFERENCES FACT.FACT_LOAN(LoanFactSK),&#10;        &#10;    );&#10;    &#10;    CREATE INDEX IDX_FP_AccountID ON FACT.FACT_PAYMENT(AccountID);&#10;    CREATE INDEX IDX_FP_LoanSK ON FACT.FACT_PAYMENT(LoanSK);&#10;    CREATE INDEX IDX_FP_CustomerSK ON FACT.FACT_PAYMENT(CustomerSK);&#10;    CREATE INDEX IDX_FP_BranchSK ON FACT.FACT_PAYMENT(BranchSK);&#10;    CREATE INDEX IDX_FP_ProductSK ON FACT.FACT_PAYMENT(ProductSK);&#10;    CREATE INDEX IDX_FP_PaymentDateSK ON FACT.FACT_PAYMENT(PaymentDateSK);&#10;    CREATE INDEX IDX_FP_NPLFlag ON FACT.FACT_PAYMENT(NPLFlag);&#10;    CREATE INDEX IDX_FP_ECL_Stage ON FACT.FACT_PAYMENT(ECL_Stage);&#10;    CREATE INDEX IDX_FP_GLPostingStatus ON FACT.FACT_PAYMENT(GLPostingStatus);&#10;    CREATE INDEX IDX_FP_ReconStatus ON FACT.FACT_PAYMENT(ReconStatus);&#10;END&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_3_CREATE_FACT_PAYMENT"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="256" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_4_CREATE_FACT_GL"/>
    <elementParameter field="TEXT" name="LABEL" value="CREATE_FACT_GL"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;FACT&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.db_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.db_password"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value=""/>
    <elementParameter field="CHECK" name="USE_SHARED_CONNECTION" value="false"/>
    <elementParameter field="TEXT" name="SHARED_CONNECTION_NAME" value=""/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_DYNAMIC_JOB" value="false"/>
    <elementParameter field="TEXT" name="CONTEXT_JOB" value=""/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;IF NOT EXISTS (SELECT 1 FROM sys.objects WHERE object_id = OBJECT_ID(N&apos;FACT.FACT_GL&apos;) AND type = N&apos;U&apos;)&#10;BEGIN&#10;    CREATE TABLE FACT.FACT_GL (&#10;        GLSK INT IDENTITY(1,1) PRIMARY KEY,&#10;        GLJournalRef NVARCHAR(100) NOT NULL,&#10;        TransactionType VARCHAR(50) NOT NULL,&#10;        AccountID NVARCHAR(50) NULL,&#10;        PaymentSK INT NULL,&#10;        LoanSK INT NULL,&#10;        CustomerSK INT NULL,&#10;        GLDate DATE NULL,&#10;        GLPeriod VARCHAR(7) NULL,&#10;        GLYear INT NULL,&#10;        GLMonth INT NULL,&#10;        DebitAccount VARCHAR(30) NULL,&#10;        CreditAccount VARCHAR(30) NULL,&#10;        DebitAmount DECIMAL(18,2) DEFAULT 0,&#10;        CreditAmount DECIMAL(18,2) DEFAULT 0,&#10;        NetAmount DECIMAL(18,2) DEFAULT 0,&#10;        CostCentre VARCHAR(20) NULL,&#10;        ProfitCentre VARCHAR(20) NULL,&#10;        BranchID VARCHAR(20) NULL,&#10;        NIMContribution DECIMAL(18,2) DEFAULT 0,&#10;        RevenueCategory VARCHAR(50) NULL,&#10;        PeriodCloseStatus VARCHAR(20) DEFAULT &apos;PENDING&apos;,&#10;        ReconFlag BIT DEFAULT 0,&#10;        ReconVariance DECIMAL(18,2) DEFAULT 0,&#10;        ETL_LOAD_DT DATETIME DEFAULT GETDATE(),&#10;        ETL_SOURCE NVARCHAR(100) DEFAULT &apos;FACT_PAYMENT_LOAD&apos;,&#10;        BATCH_ID BIGINT NULL,&#10;        CONSTRAINT UQ_FACT_GL UNIQUE(GLJournalRef, TransactionType)&#10;    );&#10;    &#10;    CREATE INDEX IDX_FGL_PaymentSK ON FACT.FACT_GL(PaymentSK);&#10;    CREATE INDEX IDX_FGL_GLDate ON FACT.FACT_GL(GLDate);&#10;    CREATE INDEX IDX_FGL_GLPeriod ON FACT.FACT_GL(GLPeriod);&#10;    CREATE INDEX IDX_FGL_TransactionType ON FACT.FACT_GL(TransactionType);&#10;    CREATE INDEX IDX_FGL_BranchID ON FACT.FACT_GL(BranchID);&#10;    CREATE INDEX IDX_FGL_ReconFlag ON FACT.FACT_GL(ReconFlag);&#10;END&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_4_CREATE_FACT_GL"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="480" posY="256">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_5_CREATE_MART_FINANCE"/>
    <elementParameter field="TEXT" name="LABEL" value="CREATE_MART_FINANCE"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;MART&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.db_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.db_password"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value=""/>
    <elementParameter field="CHECK" name="USE_SHARED_CONNECTION" value="false"/>
    <elementParameter field="TEXT" name="SHARED_CONNECTION_NAME" value=""/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_DYNAMIC_JOB" value="false"/>
    <elementParameter field="TEXT" name="CONTEXT_JOB" value=""/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = &apos;MART&apos;)&#10;BEGIN&#10;    EXEC(&apos;CREATE SCHEMA MART&apos;);&#10;END&#10;&#10;IF NOT EXISTS (SELECT 1 FROM sys.objects WHERE object_id = OBJECT_ID(N&apos;MART.MART_FINANCE_SUMMARY&apos;) AND type = N&apos;U&apos;)&#10;BEGIN&#10;    CREATE TABLE MART.MART_FINANCE_SUMMARY (&#10;        SummaryID INT IDENTITY(1,1) PRIMARY KEY,&#10;        ReportDate DATE NOT NULL,&#10;        GLPeriod VARCHAR(7) NOT NULL,&#10;        BranchID VARCHAR(20) NOT NULL,&#10;        ProductID VARCHAR(20) NOT NULL,&#10;        TotalPaymentsReceived INT DEFAULT 0,&#10;        TotalPrincipalCollected DECIMAL(18,2) DEFAULT 0,&#10;        TotalInterestIncome DECIMAL(18,2) DEFAULT 0,&#10;        TotalFeesIncome DECIMAL(18,2) DEFAULT 0,&#10;        TotalPenaltyIncome DECIMAL(18,2) DEFAULT 0,&#10;        TotalRevenue DECIMAL(18,2) DEFAULT 0,&#10;        TotalArrearsAmount DECIMAL(18,2) DEFAULT 0,&#10;        ArrearsRatio DECIMAL(8,4) DEFAULT 0,&#10;        NPLCount INT DEFAULT 0,&#10;        NPLAmount DECIMAL(18,2) DEFAULT 0,&#10;        NPLRatio DECIMAL(8,4) DEFAULT 0,&#10;        ECL_Stage1_Amount DECIMAL(18,2) DEFAULT 0,&#10;        ECL_Stage2_Amount DECIMAL(18,2) DEFAULT 0,&#10;        ECL_Stage3_Amount DECIMAL(18,2) DEFAULT 0,&#10;        TotalProvision DECIMAL(18,2) DEFAULT 0,&#10;        ProvisionCoverageRatio DECIMAL(8,4) DEFAULT 0,&#10;        EarlyPaymentCount INT DEFAULT 0,&#10;        PartialPaymentCount INT DEFAULT 0,&#10;        LatePaymentCount INT DEFAULT 0,&#10;        PaymentEfficiencyAvg DECIMAL(8,4) DEFAULT 0,&#10;        NIM DECIMAL(8,4) DEFAULT 0,&#10;        CostOfRisk DECIMAL(8,4) DEFAULT 0,&#10;        RevenueAtRisk DECIMAL(18,2) DEFAULT 0,&#10;        ETL_LOAD_DT DATETIME DEFAULT GETDATE(),&#10;        ETL_SOURCE VARCHAR(50) DEFAULT &apos;FACT_PAYMENT_LOAD&apos;,&#10;        CONSTRAINT UQ_MART_FINANCE UNIQUE(ReportDate, GLPeriod, BranchID, ProductID)&#10;    );&#10;END&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_5_CREATE_MART_FINANCE"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="320">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_6_VERIFY_DATATYPES"/>
    <elementParameter field="TEXT" name="LABEL" value="VERIFY_DATATYPES"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;LOAN_SRC&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.db_user"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.db_password"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value=""/>
    <elementParameter field="CHECK" name="USE_SHARED_CONNECTION" value="false"/>
    <elementParameter field="TEXT" name="SHARED_CONNECTION_NAME" value=""/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;"/>
    <elementParameter field="CHECK" name="USE_DYNAMIC_JOB" value="false"/>
    <elementParameter field="TEXT" name="CONTEXT_JOB" value=""/>
    <elementParameter field="CHECK" name="PROPAGATE_RECORD_SET" value="false"/>
    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="-- VERIFY_DATATYPES: check source columns and fix type mismatches before load&#10;-- 1. Ensure PaymentDate and DueDate are valid dates&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET PaymentDate = NULL WHERE TRY_CAST(PaymentDate AS DATE) IS NULL AND PaymentDate IS NOT NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET DueDate = NULL WHERE TRY_CAST(DueDate AS DATE) IS NULL AND DueDate IS NOT NULL;&#10;-- 2. Ensure numeric columns are not overflowing&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET TotalAmount = 0 WHERE TRY_CAST(TotalAmount AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET PrincipalAmount = 0 WHERE TRY_CAST(PrincipalAmount AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET InterestAmount = 0 WHERE TRY_CAST(InterestAmount AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET FeesAmount = 0 WHERE TRY_CAST(FeesAmount AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET PenaltyAmount = 0 WHERE TRY_CAST(PenaltyAmount AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET RunningBalance = 0 WHERE TRY_CAST(RunningBalance AS DECIMAL(18,2)) IS NULL;&#10;UPDATE LOAN_SRC.LOAN_PAYMENT SET DaysPastDue = 0 WHERE TRY_CAST(DaysPastDue AS INT) IS NULL;&#10;-- 3. Ensure FACT_LOAN numeric columns are safe&#10;UPDATE FACT.FACT_LOAN SET LoanAmount = 0 WHERE LoanAmount IS NULL OR LoanAmount &lt; 0;&#10;UPDATE FACT.FACT_LOAN SET InterestRate = 0 WHERE InterestRate IS NULL OR InterestRate &lt; 0;&#10;UPDATE FACT.FACT_LOAN SET TermMonths = 12 WHERE TermMonths IS NULL OR TermMonths &lt;= 0;&#10;UPDATE FACT.FACT_LOAN SET MonthlyInstalment = 0 WHERE MonthlyInstalment IS NULL;&#10;UPDATE FACT.FACT_LOAN SET LGD = 0.45 WHERE LGD IS NULL OR LGD &lt;= 0;&#10;UPDATE FACT.FACT_LOAN SET OutstandingBalance = 0 WHERE OutstandingBalance IS NULL;&#10;-- 4. Log datatype verification result&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG(BatchID,PackageName,StepName,StartTime,RowsProcessed,Status)&#10;SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&#10;&apos;FACT_PAYMENT_LOAD&apos;,&apos;VERIFY_DATATYPES&apos;,GETDATE(),COUNT(*),(CASE WHEN COUNT(*)&gt;0 THEN &apos;OK&apos; ELSE &apos;WARN_EMPTY&apos; END)&#10;FROM LOAN_SRC.LOAN_PAYMENT WHERE PaymentDate IS NOT NULL AND TotalAmount &gt; 0;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_6_VERIFY_DATATYPES"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="368">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_7_LOAD_FACT_PAYMENT"/>
    <elementParameter field="TEXT" name="LABEL" value="LOAD_FACT_PAYMENT"/>
    <elementParameter field="TEXT" name="HOST" value="context.db_host"/>
    <elementParameter field="TEXT" name="PORT" value="context.db_port"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.db_name"/>
