    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;DECLARE @prior VARCHAR(7) = FORMAT(DATEADD(MONTH, -1, GETDATE()), &apos;yyyy-MM&apos;);&#10;&#10;UPDATE FACT.FACT_GL &#10;SET PeriodCloseStatus = &apos;CLOSED&apos;,&#10;    ReconFlag = 1,&#10;    ReconVariance = ABS(DebitAmount - CreditAmount)&#10;WHERE ABS(DebitAmount - CreditAmount) &lt; 0.01 &#10;AND PeriodCloseStatus = &apos;PENDING&apos; &#10;AND GLPeriod = @prior;&#10;&#10;DECLARE @rows INT = @@ROWCOUNT;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status)&#10;VALUES(CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;FACT_PAYMENT_LOAD&apos;,&apos;GL_PERIOD_CLOSE&apos;,GETDATE(),@rows,&apos;OK&apos;);&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_9_GL_PERIOD_CLOSE"/>
  </node>
