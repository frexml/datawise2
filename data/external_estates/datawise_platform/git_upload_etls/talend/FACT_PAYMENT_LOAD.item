    <elementParameter field="CHECK" name="DIE_ON_ERROR" value="true"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO FACT.FACT_GL (&#10;    GLJournalRef, TransactionType, AccountID, PaymentSK, LoanSK, CustomerSK,&#10;    GLDate, GLPeriod, GLYear, GLMonth,&#10;    DebitAccount, CreditAccount, DebitAmount, CreditAmount, NetAmount,&#10;    CostCentre, ProfitCentre, BranchID,&#10;    NIMContribution, RevenueCategory,&#10;    PeriodCloseStatus, ReconFlag, ReconVariance,&#10;    ETL_LOAD_DT, ETL_SOURCE, BATCH_ID&#10;)&#10;SELECT &#10;    fp.GLJournalRef,&#10;    gl.TransactionType,&#10;    fp.AccountID,&#10;    fp.PaymentSK,&#10;    fp.LoanSK,&#10;    fp.CustomerSK,&#10;    fp.GLPostingDate,&#10;    FORMAT(fp.GLPostingDate, &apos;yyyy-MM&apos;),&#10;    YEAR(fp.GLPostingDate),&#10;    MONTH(fp.GLPostingDate),&#10;    gl.DebitAccount,&#10;    gl.CreditAccount,&#10;    gl.Amount,&#10;    gl.Amount,&#10;    gl.Amount,&#10;    b.BranchID,&#10;    b.BranchID,&#10;    b.BranchID,&#10;    CASE WHEN gl.TransactionType = &apos;INTEREST_INCOME&apos; THEN gl.Amount ELSE 0 END,&#10;    gl.RevenueCategory,&#10;    &apos;PENDING&apos;,&#10;    0,&#10;    0,&#10;    GETDATE(),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    CONVERT(BIGINT, CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;))&#10;FROM FACT.FACT_PAYMENT fp&#10;INNER JOIN FACT.FACT_LOAN fl ON fp.LoanSK = fl.LoanFactSK&#10;LEFT JOIN DIM.DIM_BRANCH b ON fp.BranchSK = b.BranchSK&#10;LEFT JOIN DIM.DIM_PRODUCT pr ON fp.ProductSK = pr.ProductSK&#10;CROSS APPLY (&#10;    VALUES&#10;        (&apos;1001-LOANS-RECEIVABLE&apos;, &apos;1002-CASH&apos;, fp.PrincipalAllocation, &apos;PRINCIPAL_REPAYMENT&apos;, &apos;Interest Revenue&apos;),&#10;        (&apos;1002-CASH&apos;, &apos;4001-INTEREST-INCOME&apos;, fp.InterestAllocation, &apos;INTEREST_INCOME&apos;, &apos;Interest Revenue&apos;),&#10;        (&apos;1002-CASH&apos;, &apos;4002-FEE-INCOME&apos;, fp.FeesAmount, &apos;FEE_INCOME&apos;, &apos;Fee Revenue&apos;),&#10;        (&apos;5001-PROVISION-EXPENSE&apos;, &apos;1003-LOAN-LOSS-RESERVE&apos;, fp.ProvisionAmount, &apos;PROVISION&apos;, &apos;Provision Expense&apos;)&#10;) gl(DebitAccount, CreditAccount, Amount, TransactionType, RevenueCategory)&#10;WHERE gl.Amount > 0&#10;AND NOT EXISTS (&#10;    SELECT 1 &#10;    FROM FACT.FACT_GL t &#10;    WHERE t.GLJournalRef = fp.GLJournalRef &#10;    AND t.TransactionType = gl.TransactionType&#10;);&#10;&#10;DECLARE @rows INT = @@ROWCOUNT;&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;VALUES (&#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;LOAD_FACT_GL&apos;,&#10;    GETDATE(),&#10;    @rows,&#10;    &apos;OK&apos;&#10;);&quot;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_8_LOAD_FACT_GL"/>
  </node>
