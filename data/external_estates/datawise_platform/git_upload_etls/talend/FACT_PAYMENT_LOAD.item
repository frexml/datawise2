    <elementParameter field="MEMO_SQL" name="QUERY" value="INSERT INTO FACT.FACT_PAYMENT (PaymentID,AccountID,LoanSK,CustomerSK,BranchSK,ProductSK,PaymentDateSK,DueDateSK,PrincipalAmount,InterestAmount,FeesAmount,PenaltyAmount,TotalAmount,RunningBalance,OutstandingBalanceAfter,DaysPastDue,DaysLate,IsLate,ArrearsFlag,ArrearsAmount,ArrearsAgingBucket,PaymentMethod,PaymentStatus,PaymentChannel,AllocationStatus,PrincipalAllocation,InterestAllocation,FeesAllocation,CumulativePrincipalPaid,CumulativeInterestPaid,RemainingPrincipal,RemainingTerm,EarlyPaymentFlag,PartialPaymentFlag,PaymentEfficiencyRatio,NPLFlag,WatchListFlag,ProvisionAmount,ProvisionRate,ECL_Stage,ECL_Amount,GLPostingStatus,GLJournalRef,GLPostingDate,ReconStatus,ReconVariance,ETL_LOAD_DT,ETL_SOURCE,BATCH_ID)&#10;SELECT&#10;p.PaymentID,&#10;p.AccountID,&#10;fl.LoanFactSK,&#10;c.CustomerSK,&#10;b.BranchSK,&#10;pr.ProductSK,&#10;TRY_CAST(CONVERT(VARCHAR,p.PaymentDate,112) AS INT),&#10;TRY_CAST(CONVERT(VARCHAR,p.DueDate,112) AS INT),&#10;CAST(ISNULL(p.PrincipalAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.InterestAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.FeesAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.PenaltyAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.TotalAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.RunningBalance,0) AS DECIMAL(18,2)),&#10;CAST(fl.OutstandingBalance-(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0))) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.DaysPastDue,0) AS INT),&#10;CAST(CASE WHEN p.PaymentDate&gt;p.DueDate THEN DATEDIFF(DAY,p.DueDate,p.PaymentDate) ELSE 0 END AS INT),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)&gt;0 THEN 1 ELSE 0 END AS BIT),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)&gt;0 THEN 1 ELSE 0 END AS BIT),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)&gt;0 THEN ISNULL(p.TotalAmount,0) ELSE 0 END AS DECIMAL(18,2)),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)=0 THEN &apos;Current&apos; WHEN p.DaysPastDue&lt;=30 THEN &apos;1-30&apos; WHEN p.DaysPastDue&lt;=60 THEN &apos;31-60&apos; WHEN p.DaysPastDue&lt;=90 THEN &apos;61-90&apos; ELSE &apos;90+&apos; END AS VARCHAR(20)),&#10;CAST(p.PaymentMethod AS NVARCHAR(50)),&#10;CAST(p.PaymentStatus AS NVARCHAR(50)),&#10;CAST(p.PaymentMethod AS NVARCHAR(50)),&#10;CAST(&apos;ALLOCATED&apos; AS NVARCHAR(50)),&#10;CAST(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0)) AS DECIMAL(18,2)),&#10;CAST(p.TotalAmount-(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0)))-ISNULL(p.FeesAmount,0)-ISNULL(p.PenaltyAmount,0) AS DECIMAL(18,2)),&#10;CAST(ISNULL(p.FeesAmount,0) AS DECIMAL(18,2)),&#10;CAST(0 AS DECIMAL(18,2)),&#10;CAST(0 AS DECIMAL(18,2)),&#10;CAST(fl.OutstandingBalance-(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0))) AS DECIMAL(18,2)),&#10;CAST(fl.TermMonths AS INT),&#10;CAST(CASE WHEN p.PaymentDate&lt;p.DueDate THEN 1 ELSE 0 END AS BIT),&#10;CAST(CASE WHEN p.TotalAmount&lt;fl.MonthlyInstalment*0.95 THEN 1 ELSE 0 END AS BIT),&#10;CAST(CASE WHEN fl.MonthlyInstalment&gt;0 THEN p.TotalAmount/fl.MonthlyInstalment ELSE 0 END AS DECIMAL(8,4)),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)&gt;90 THEN 1 ELSE 0 END AS BIT),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0) BETWEEN 30 AND 90 THEN 1 ELSE 0 END AS BIT),&#10;CAST((fl.OutstandingBalance-(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0))))*CASE WHEN ISNULL(p.DaysPastDue,0)=0 THEN 0.01 WHEN p.DaysPastDue&lt;=90 THEN 0.20 ELSE 1.00 END AS DECIMAL(18,2)),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)=0 THEN 0.01 WHEN p.DaysPastDue&lt;=90 THEN 0.20 ELSE 1.00 END AS DECIMAL(8,4)),&#10;CAST(CASE WHEN ISNULL(p.DaysPastDue,0)=0 THEN 1 WHEN p.DaysPastDue&lt;=90 THEN 2 ELSE 3 END AS INT),&#10;CAST((fl.OutstandingBalance-(p.TotalAmount*(fl.LoanAmount/NULLIF(fl.LoanAmount+fl.InterestRate*fl.LoanAmount*fl.TermMonths/1200.0,0))))*CASE WHEN ISNULL(p.DaysPastDue,0)=0 THEN 0.01 WHEN p.DaysPastDue&lt;=90 THEN 0.20 ELSE 1.00 END*ISNULL(fl.LGD,0.45) AS DECIMAL(18,2)),&#10;CAST(&apos;PENDING&apos; AS VARCHAR(20)),&#10;CAST(CONCAT(&apos;GL-&apos;,p.PaymentID,&apos;-&apos;,CONVERT(VARCHAR,GETDATE(),112)) AS NVARCHAR(100)),&#10;CAST(p.PaymentDate AS DATE),&#10;CAST(&apos;UNRECONCILED&apos; AS VARCHAR(20)),&#10;CAST(0 AS DECIMAL(18,2)),&#10;GETDATE(),&#10;CAST(&apos;LOAN_SRC.LOAN_PAYMENT&apos; AS NVARCHAR(100)),&#10;CONVERT(BIGINT,CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;))&#10;FROM LOAN_SRC.LOAN_PAYMENT p&#10;INNER JOIN FACT.FACT_LOAN fl ON p.AccountID=fl.AccountID&#10;INNER JOIN DIM.DIM_CUSTOMER c ON fl.CustomerSK=c.CustomerSK AND c.IsCurrent=1&#10;INNER JOIN DIM.DIM_BRANCH b ON fl.BranchSK=b.BranchSK&#10;INNER JOIN DIM.DIM_PRODUCT pr ON fl.ProductSK=pr.ProductSK&#10;LEFT JOIN DIM.DIM_DATE dd_pay ON dd_pay.DateSK=TRY_CAST(CONVERT(VARCHAR,p.PaymentDate,112) AS INT)&#10;LEFT JOIN DIM.DIM_DATE dd_due ON dd_due.DateSK=TRY_CAST(CONVERT(VARCHAR,p.DueDate,112) AS INT)&#10;WHERE NOT EXISTS (SELECT 1 FROM FACT.FACT_PAYMENT t WHERE t.PaymentID=p.PaymentID);&#10;INSERT INTO DW_AUDIT.ETL_BATCH_LOG(BatchID,PackageName,StepName,StartTime,RowsProcessed,Status)&#10;VALUES(CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;FACT_PAYMENT_LOAD&apos;,&apos;LOAD_FACT_PAYMENT&apos;,GETDATE(),@@ROWCOUNT,&apos;OK&apos;);"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tMSSqlRow_7_LOAD_FACT_PAYMENT"/>
  </node>
  <node componentName="tMSSqlRow" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="224" posY="464">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlRow_8_LOAD_FACT_GL"/>
