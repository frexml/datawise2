    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, Status)&#10;VALUES (&#10;    CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;),&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    &apos;PACKAGE_START&apos;,&#10;    GETDATE(),&#10;    &apos;RUNNING&apos;&#10;)&quot;"/>
