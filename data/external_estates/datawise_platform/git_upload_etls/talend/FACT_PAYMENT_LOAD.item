    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID, PackageName, StepName, StartTime, RowsProcessed, Status)&#10;SELECT &#10;    b.batchid,&#10;    &apos;FACT_PAYMENT_LOAD&apos;,&#10;    x.tbl,&#10;    GETDATE(),&#10;    x.cnt,&#10;    &apos;OK&apos;&#10;FROM (&#10;    SELECT &apos;FACT_PAYMENT&apos; AS tbl, COUNT(*) AS cnt FROM FACT.FACT_PAYMENT&#10;    UNION ALL&#10;    SELECT &apos;FACT_GL&apos;, COUNT(*) FROM FACT.FACT_GL&#10;    UNION ALL&#10;    SELECT &apos;MART_FINANCE_SUMMARY&apos;, COUNT(*) FROM MART.MART_FINANCE_SUMMARY&#10;) x&#10;CROSS JOIN (&#10;    SELECT CONVERT(VARCHAR, GETDATE(), 112) + REPLACE(CONVERT(VARCHAR, GETDATE(), 108), &apos;:&apos;, &apos;&apos;) AS batchid&#10;) b;&quot;"/>
