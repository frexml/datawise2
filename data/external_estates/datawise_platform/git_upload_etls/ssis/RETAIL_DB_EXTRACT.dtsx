    <DTS:Executable
      DTS:refId="Package\AUDIT_START"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{A1B2C3D4-E5F6-4A5B-8C9D-1E2F3A4B5C6D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="AUDIT_START"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,Status) VALUES (CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_EXTRACT&apos;,&apos;PACKAGE_START&apos;,GETDATE(),&apos;RUNNING&apos;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RETAIL_CUSTOMER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{6B8CEC32-2510-4192-821C-41A3410B2C07}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RETAIL_CUSTOMER"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('RETAIL_SRC.RETAIL_DB_RAW','U') IS NULL CREATE TABLE RETAIL_SRC.RETAIL_DB_RAW (TransactionID VARCHAR(30),TransactionDate VARCHAR(20),TransactionTime VARCHAR(20),TransactionType VARCHAR(20),Channel VARCHAR(30),Amount VARCHAR(30),Currency VARCHAR(5),Status VARCHAR(20),ReferenceNo VARCHAR(50),Description VARCHAR(500),AccountNo VARCHAR(30),AccountType VARCHAR(50),AccountOpenDate VARCHAR(20),BalanceBefore VARCHAR(30),BalanceAfter VARCHAR(30),AvailableBalance VARCHAR(30),AccountStatus VARCHAR(20),OverdraftLimit VARCHAR(30),CustomerID VARCHAR(20),FirstName VARCHAR(100),LastName VARCHAR(100),DateOfBirth VARCHAR(20),Email VARCHAR(200),Phone VARCHAR(30),Segment VARCHAR(50),LoyaltyTier VARCHAR(20),Region VARCHAR(100),City VARCHAR(100),Country VARCHAR(100),AnnualIncome VARCHAR(30),CustomerSince VARCHAR(20),LastLoginDate VARCHAR(20),PreferredChannel VARCHAR(50),ChurnRiskScore VARCHAR(20),TotalLifetimeTransactions VARCHAR(10),TotalLifetimeValue VARCHAR(30),MerchantID VARCHAR(30),MerchantName VARCHAR(200),MerchantCategory VARCHAR(100),MerchantCity VARCHAR(100),FraudFlag VARCHAR(1),FraudScore VARCHAR(20),FraudRuleTriggered VARCHAR(200),FraudAlertLevel VARCHAR(20),IsNewMerchant VARCHAR(5),IsNewChannel VARCHAR(5),VelocityFlag VARCHAR(5),BranchID VARCHAR(20),BranchName VARCHAR(200),SourceSystem VARCHAR(30),ExtractTimestamp VARCHAR(30),BatchID VARCHAR(30)); DELETE FROM RETAIL_SRC.RETAIL_DB_RAW; BULK INSERT RETAIL_SRC.RETAIL_DB_RAW FROM 'retaildb/RETAIL_DB_RAW.csv' WITH (DATA_SOURCE='AzureBlobStorage',FORMAT='CSV',FIRSTROW=2,FIELDTERMINATOR=',',ROWTERMINATOR='0x0a',TABLOCK); INSERT INTO RETAIL_SRC.RETAIL_CUSTOMER (CustomerID,FirstName,LastName,DateOfBirth,Email,Phone,Segment,AccountType,AccountOpenDate,BranchID,Region,City,Country,AnnualIncome,LifetimeValue,ChurnRisk,LastTransactionDate,TotalTransactions,TotalSpend,PreferredChannel,LoyaltyTier) SELECT CustomerID,MAX(FirstName),MAX(LastName),MAX(TRY_CAST(DateOfBirth AS DATE)),MAX(Email),MAX(Phone),MAX(Segment),MAX(AccountType),MAX(TRY_CAST(AccountOpenDate AS DATE)),MAX(BranchID),MAX(Region),MAX(City),MAX(Country),MAX(TRY_CAST(AnnualIncome AS DECIMAL(18,2))),MAX(TRY_CAST(TotalLifetimeValue AS DECIMAL(18,2))),MAX(CASE WHEN TRY_CAST(ChurnRiskScore AS DECIMAL(5,4))&gt;=0.7 THEN &apos;High&apos; WHEN TRY_CAST(ChurnRiskScore AS DECIMAL(5,4))&gt;=0.4 THEN &apos;Medium&apos; ELSE &apos;Low&apos; END),MAX(TRY_CAST(TransactionDate AS DATE)),MAX(TRY_CAST(TotalLifetimeTransactions AS INT)),MAX(TRY_CAST(TotalLifetimeValue AS DECIMAL(18,2))),MAX(PreferredChannel),MAX(LoyaltyTier) FROM RETAIL_SRC.RETAIL_DB_RAW r WHERE r.CustomerID IS NOT NULL AND r.CustomerID&lt;&gt;&apos;&apos; AND NOT EXISTS (SELECT 1 FROM RETAIL_SRC.RETAIL_CUSTOMER t WHERE t.CustomerID=r.CustomerID) GROUP BY CustomerID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\PROFILE_TRANSACTIONS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{B2C3D4E5-F6A7-4B5C-9D8E-2F3A4B5C6D7E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="PROFILE_TRANSACTIONS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_EXTRACT&apos;,&apos;PROFILE_TRANSACTIONS&apos;,GETDATE(),COUNT(*),CASE WHEN COUNT(*)&gt;0 THEN &apos;OK&apos; ELSE &apos;WARN_EMPTY&apos; END FROM RETAIL_SRC.RETAIL_DB_RAW;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_RETAIL_BRANCH"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{C3D4E5F6-A7B8-4C5D-9E8F-3A4B5C6D7E8F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_RETAIL_BRANCH"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;LOAN_SRC.BRANCH&apos;,&apos;U&apos;) IS NOT NULL BEGIN TRY INSERT INTO LOAN_SRC.BRANCH (BranchID,BranchName,BranchCode,Region,City,State,Country,BranchManager,StaffCount,OpenDate,BranchType,ATMCount,Status) SELECT DISTINCT BranchID,BranchName,BranchID,Region,City,NULL,&apos;Nigeria&apos;,NULL,NULL,NULL,&apos;Full Service&apos;,NULL,&apos;Active&apos; FROM RETAIL_SRC.RETAIL_DB_RAW r WHERE r.BranchID IS NOT NULL AND r.BranchID &lt;&gt; &apos;&apos; AND NOT EXISTS (SELECT 1 FROM LOAN_SRC.BRANCH t WHERE t.BranchID=r.BranchID); END TRY BEGIN CATCH END CATCH;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RETAIL_TRANSACTION"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{B3CFAE57-0559-4033-ADFB-60C895F1D4B7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RETAIL_TRANSACTION"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="INSERT INTO RETAIL_SRC.RETAIL_TRANSACTION (TransactionID,CustomerID,AccountNo,TransactionDate,TransactionTime,TransactionType,Channel,Amount,Currency,MerchantID,MerchantCategory,BranchID,Description,BalanceBefore,BalanceAfter,FraudFlag,FraudScore,Status,ReferenceNo) SELECT DISTINCT TransactionID,CustomerID,AccountNo,TRY_CAST(TransactionDate AS DATE),TRY_CAST(TransactionTime AS TIME),TransactionType,Channel,TRY_CAST(Amount AS DECIMAL(18,2)),Currency,MerchantID,MerchantCategory,BranchID,Description,TRY_CAST(BalanceBefore AS DECIMAL(18,2)),TRY_CAST(BalanceAfter AS DECIMAL(18,2)),FraudFlag,TRY_CAST(FraudScore AS DECIMAL(5,4)),Status,ReferenceNo FROM RETAIL_SRC.RETAIL_DB_RAW r WHERE r.TransactionID IS NOT NULL AND r.TransactionID&lt;&gt;&apos;&apos; AND NOT EXISTS (SELECT 1 FROM RETAIL_SRC.RETAIL_TRANSACTION t WHERE t.TransactionID=r.TransactionID);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\FLAG_FRAUD_CANDIDATES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{D4E5F6A7-B8C9-4D5E-9F8A-4B5C6D7E8F9A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="FLAG_FRAUD_CANDIDATES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_EXTRACT&apos;,&apos;FLAG_FRAUD_CANDIDATES&apos;,GETDATE(),COUNT(*),CASE WHEN COUNT(*)&gt;0 THEN &apos;WARN_FRAUD_DETECTED&apos; ELSE &apos;OK&apos; END FROM RETAIL_SRC.RETAIL_TRANSACTION WHERE FraudScore &gt;= 0.7 OR FraudFlag=&apos;Y&apos;;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ROWCOUNT_METADATA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{E5F6A7B8-C9D0-4E5F-9A8B-5C6D7E8F9A0B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ROWCOUNT_METADATA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B1867C8E-6377-4D98-B643-0D05D55EB8E5}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_EXTRACT&apos;,tbl,GETDATE(),cnt,&apos;OK&apos; FROM ( SELECT &apos;RETAIL_CUSTOMER&apos; tbl,COUNT(*) cnt FROM RETAIL_SRC.RETAIL_CUSTOMER UNION ALL SELECT &apos;RETAIL_TRANSACTION&apos;,COUNT(*) FROM RETAIL_SRC.RETAIL_TRANSACTION ) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
