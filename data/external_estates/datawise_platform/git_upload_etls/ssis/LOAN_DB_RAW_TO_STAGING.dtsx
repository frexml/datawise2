      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;LOAN_DB_RAW_TO_STAGING&apos;,&apos;VALIDATE_SRC&apos;,GETDATE(),(SELECT COUNT(*) FROM LOAN_SRC.BORROWER),CASE WHEN (SELECT COUNT(*) FROM LOAN_SRC.BORROWER)=0 THEN &apos;WARN_EMPTY&apos; ELSE &apos;OK&apos; END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
