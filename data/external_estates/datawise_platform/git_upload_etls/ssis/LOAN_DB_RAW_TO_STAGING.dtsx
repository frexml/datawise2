    <DTS:Executable
      DTS:refId="Package\LOAD_DIM_BRANCH"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{27CE8C19-45DF-4DA5-AC77-919D73125F49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_DIM_BRANCH"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DIM.DIM_BRANCH (BranchID,BranchName,BranchCode,Region,City,State,Country,BranchManager,StaffCount,OpenDate,BranchType,ATMCount,Status,ETL_LOAD_DT) SELECT BranchID,BranchName,BranchCode,Region,City,State,Country,BranchManager,StaffCount,OpenDate,BranchType,ATMCount,Status,ETL_LOAD_DT FROM LOAN_SRC.BRANCH s WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_BRANCH t WHERE t.BranchID=s.BranchID)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_DIM_PRODUCT"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{B1523B68-267C-4E23-AA39-343693B16F1D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_DIM_PRODUCT"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DIM.DIM_PRODUCT (ProductID,ProductName,ProductCode,ProductCategory,MinAmount,MaxAmount,MinTermMonths,MaxTermMonths,BaseRate,CollateralRequired,TargetSegment,RiskWeight,BaselCategory,Status,LaunchDate,ETL_LOAD_DT) SELECT ProductID,ProductName,ProductCode,ProductCategory,MinAmount,MaxAmount,MinTermMonths,MaxTermMonths,BaseRate,CollateralRequired,TargetSegment,RiskWeight,BaselCategory,Status,LaunchDate,ETL_LOAD_DT FROM LOAN_SRC.LOAN_PRODUCT s WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_PRODUCT t WHERE t.ProductID=s.ProductID)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_DIM_CUSTOMER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{0B35E748-825C-4EAD-8E52-10BAF3D29AB9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_DIM_CUSTOMER"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DIM.DIM_CUSTOMER (CustomerID,SourceSystem,FirstName,LastName,DateOfBirth,Email,Phone,NationalID,Region,City,Country,AnnualIncome,CreditScore,KYCStatus,RelationshipScore,EmploymentStatus,EmployerName,YearsEmployed,EffectiveDate,ExpiryDate,IsCurrent,ETL_LOAD_DT,ETL_SOURCE) SELECT BorrowerID,&apos;LOAN_DB&apos;,FirstName,LastName,DateOfBirth,Email,Phone,NationalID,AddressCity,AddressCity,AddressCountry,AnnualIncome,CreditScore,KYCStatus,RelationshipScore,EmploymentStatus,EmployerName,YearsEmployed,CAST(GETDATE() AS DATE),&apos;9999-12-31&apos;,1,GETDATE(),&apos;SSIS&apos; FROM LOAN_SRC.BORROWER s WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_CUSTOMER t WHERE t.CustomerID=s.BorrowerID AND t.SourceSystem=&apos;LOAN_DB&apos;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SCD2_DIM_CUSTOMER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{C3D4E5F6-A7B8-4C5D-9E1F-2A3B4C5D6E7F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCD2_DIM_CUSTOMER"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="UPDATE DIM.DIM_CUSTOMER SET ExpiryDate=CAST(GETDATE() AS DATE), IsCurrent=0 FROM DIM.DIM_CUSTOMER d INNER JOIN LOAN_SRC.BORROWER s ON d.CustomerID=s.BorrowerID AND d.SourceSystem=&apos;LOAN_DB&apos; AND d.IsCurrent=1 WHERE d.AnnualIncome &lt;&gt; s.AnnualIncome OR d.CreditScore &lt;&gt; s.CreditScore OR d.KYCStatus &lt;&gt; s.KYCStatus; INSERT INTO DIM.DIM_CUSTOMER (CustomerID,SourceSystem,FirstName,LastName,DateOfBirth,Email,Phone,NationalID,Region,City,Country,AnnualIncome,CreditScore,KYCStatus,RelationshipScore,EmploymentStatus,EmployerName,YearsEmployed,EffectiveDate,ExpiryDate,IsCurrent,ETL_LOAD_DT,ETL_SOURCE) SELECT s.BorrowerID,&apos;LOAN_DB&apos;,s.FirstName,s.LastName,s.DateOfBirth,s.Email,s.Phone,s.NationalID,s.AddressCity,s.AddressCity,s.AddressCountry,s.AnnualIncome,s.CreditScore,s.KYCStatus,s.RelationshipScore,s.EmploymentStatus,s.EmployerName,s.YearsEmployed,CAST(GETDATE() AS DATE),&apos;9999-12-31&apos;,1,GETDATE(),&apos;SSIS&apos; FROM LOAN_SRC.BORROWER s WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_CUSTOMER d WHERE d.CustomerID=s.BorrowerID AND d.SourceSystem=&apos;LOAN_DB&apos; AND d.IsCurrent=1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\VALIDATE_DIM_KEYS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{D4E5F6A7-B8C9-4D5E-9F1A-2B3C4D5E6F7A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="VALIDATE_DIM_KEYS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;LOAN_DB_RAW_TO_STAGING&apos;,&apos;VALIDATE_DIM_KEYS&apos;,GETDATE(),COUNT(*),CASE WHEN COUNT(*)=0 THEN &apos;WARN_NO_MATCHES&apos; ELSE &apos;OK&apos; END FROM LOAN_SRC.LOAN_ACCOUNT a INNER JOIN DIM.DIM_CUSTOMER c ON a.BorrowerID=c.CustomerID AND c.IsCurrent=1 INNER JOIN DIM.DIM_PRODUCT p ON a.ProductID=p.ProductID INNER JOIN DIM.DIM_BRANCH b ON a.BranchID=b.BranchID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_FACT_LOAN"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{1191CD21-8287-40BB-B067-DC2559BB37AE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_FACT_LOAN"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO FACT.FACT_LOAN (AccountID,ApplicationID,CustomerSK,ProductSK,BranchSK,ApplicationDateSK,DisbursementDateSK,LoanAmount,OutstandingBalance,InterestRate,TermMonths,MonthlyInstalment,DaysPastDue,ArrearsAmount,PD,LGD,EAD,RWA,AccountStatus,ApplicationStatus,ETL_LOAD_DT,ETL_SOURCE) SELECT a.AccountID,a.ApplicationID,c.CustomerSK,p.ProductSK,b.BranchSK,dd_app.DateSK,dd_dis.DateSK,a.LoanAmount,a.OutstandingBalance,a.InterestRate,a.TermMonths,a.MonthlyInstalment,a.DaysPastDue,a.ArrearsAmount,a.PD,a.LGD,a.EAD,a.RWA,a.AccountStatus,app.ApplicationStatus,GETDATE(),&apos;SSIS&apos; FROM LOAN_SRC.LOAN_ACCOUNT a LEFT JOIN LOAN_SRC.LOAN_APPLICATION app ON a.ApplicationID=app.ApplicationID INNER JOIN DIM.DIM_CUSTOMER c ON a.BorrowerID=c.CustomerID AND c.IsCurrent=1 INNER JOIN DIM.DIM_PRODUCT p ON a.ProductID=p.ProductID INNER JOIN DIM.DIM_BRANCH b ON a.BranchID=b.BranchID LEFT JOIN DIM.DIM_DATE dd_app ON dd_app.DateSK=CAST(CONVERT(VARCHAR,app.ApplicationDate,112) AS INT) LEFT JOIN DIM.DIM_DATE dd_dis ON dd_dis.DateSK=CAST(CONVERT(VARCHAR,a.DisbursementDate,112) AS INT) WHERE NOT EXISTS (SELECT 1 FROM FACT.FACT_LOAN f WHERE f.AccountID=a.AccountID)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DQ_FACT_LOAN"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{E5F6A7B8-C9D1-4E5F-9A1B-2C3D4E5F6A7B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ_FACT_LOAN"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;LOAN_DB_RAW_TO_STAGING&apos;,&apos;DQ_FACT_LOAN_MISSING_RISK&apos;,GETDATE(),COUNT(*),CASE WHEN COUNT(*)&gt;0 THEN &apos;WARN_MISSING_RISK&apos; ELSE &apos;OK&apos; END FROM FACT.FACT_LOAN WHERE PD IS NULL OR LGD IS NULL OR EAD IS NULL OR RWA IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RECONCILE_COUNTS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{F6A7B8C9-D1E2-4F5A-9B1C-2D3E4F5A6B7C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RECONCILE_COUNTS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEF2BA30-CB7F-4716-92D7-E69C5C27ABA5}"
          SQLTask:SqlStatementSource="INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;LOAN_DB_RAW_TO_STAGING&apos;,tbl,GETDATE(),cnt,&apos;OK&apos; FROM (SELECT &apos;DIM_CUSTOMER&apos; tbl,COUNT(*) cnt FROM DIM.DIM_CUSTOMER WHERE SourceSystem=&apos;LOAN_DB&apos; UNION ALL SELECT &apos;DIM_PRODUCT&apos;,COUNT(*) FROM DIM.DIM_PRODUCT UNION ALL SELECT &apos;DIM_BRANCH&apos;,COUNT(*) FROM DIM.DIM_BRANCH UNION ALL SELECT &apos;FACT_LOAN&apos;,COUNT(*) FROM FACT.FACT_LOAN) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
