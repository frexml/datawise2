      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{1997834C-FF0C-4CB4-852F-6BEAC8B10FD1}"
          SQLTask:SqlStatementSource="INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;LOAN_DB_EXTRACT&apos;,tbl,GETDATE(),cnt,&apos;OK&apos; FROM (SELECT &apos;BORROWER&apos; tbl,COUNT(*) cnt FROM LOAN_SRC.BORROWER UNION ALL SELECT &apos;LOAN_APPLICATION&apos;,COUNT(*) FROM LOAN_SRC.LOAN_APPLICATION UNION ALL SELECT &apos;LOAN_ACCOUNT&apos;,COUNT(*) FROM LOAN_SRC.LOAN_ACCOUNT UNION ALL SELECT &apos;LOAN_PAYMENT&apos;,COUNT(*) FROM LOAN_SRC.LOAN_PAYMENT UNION ALL SELECT &apos;COLLATERAL&apos;,COUNT(*) FROM LOAN_SRC.COLLATERAL UNION ALL SELECT &apos;CREDIT_HISTORY&apos;,COUNT(*) FROM LOAN_SRC.CREDIT_HISTORY) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
