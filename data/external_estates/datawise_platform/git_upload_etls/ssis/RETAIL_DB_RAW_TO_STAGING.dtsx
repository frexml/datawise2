      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,Status) VALUES (CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_RAW_TO_STAGING&apos;,&apos;PACKAGE_START&apos;,GETDATE(),&apos;RUNNING&apos;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\VALIDATE_SRC_COUNTS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{B2C3D4E5-F6A7-4B6C-9D0E-2F3A4B5C6D7E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="VALIDATE_SRC_COUNTS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_RAW_TO_STAGING&apos;,&apos;VALIDATE_SRC&apos;,GETDATE(),(SELECT COUNT(*) FROM RETAIL_SRC.RETAIL_CUSTOMER),CASE WHEN (SELECT COUNT(*) FROM RETAIL_SRC.RETAIL_CUSTOMER)=0 THEN &apos;WARN_EMPTY&apos; ELSE &apos;OK&apos; END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_DIM_CUSTOMER_RETAIL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{7929110F-4D63-422E-BC77-D63DD2AA8728}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_DIM_CUSTOMER_RETAIL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="INSERT INTO DIM.DIM_CUSTOMER (CustomerID,SourceSystem,FirstName,LastName,DateOfBirth,Email,Phone,Segment,LoyaltyTier,Region,City,Country,AnnualIncome,ChurnRisk,LifetimeValue,PreferredChannel,EffectiveDate,ExpiryDate,IsCurrent,ETL_LOAD_DT,ETL_SOURCE) SELECT r.CustomerID,&apos;RETAIL_DB&apos;,r.FirstName,r.LastName,r.DateOfBirth,r.Email,r.Phone,r.Segment,r.LoyaltyTier,r.Region,r.City,r.Country,r.AnnualIncome,r.ChurnRisk,r.LifetimeValue,r.PreferredChannel,CAST(GETDATE() AS DATE),&apos;9999-12-31&apos;,1,GETDATE(),&apos;SSIS&apos; FROM RETAIL_SRC.RETAIL_CUSTOMER r WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_CUSTOMER d WHERE d.CustomerID=r.CustomerID AND d.IsCurrent=1)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SCD2_RETAIL_CUSTOMER"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{C3D4E5F6-A7B8-4C7D-0E1F-3A4B5C6D7E8F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SCD2_RETAIL_CUSTOMER"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="UPDATE DIM.DIM_CUSTOMER SET ExpiryDate=CAST(GETDATE() AS DATE),IsCurrent=0 FROM DIM.DIM_CUSTOMER d INNER JOIN RETAIL_SRC.RETAIL_CUSTOMER s ON d.CustomerID=s.CustomerID AND d.SourceSystem=&apos;RETAIL_DB&apos; AND d.IsCurrent=1 WHERE d.AnnualIncome &lt;&gt; s.AnnualIncome OR d.ChurnRisk &lt;&gt; s.ChurnRisk OR d.LoyaltyTier &lt;&gt; s.LoyaltyTier; INSERT INTO DIM.DIM_CUSTOMER (CustomerID,SourceSystem,FirstName,LastName,DateOfBirth,Email,Phone,Segment,LoyaltyTier,Region,City,Country,AnnualIncome,ChurnRisk,LifetimeValue,PreferredChannel,EffectiveDate,ExpiryDate,IsCurrent,ETL_LOAD_DT,ETL_SOURCE) SELECT s.CustomerID,&apos;RETAIL_DB&apos;,s.FirstName,s.LastName,s.DateOfBirth,s.Email,s.Phone,s.Segment,s.LoyaltyTier,s.Region,s.City,s.Country,s.AnnualIncome,s.ChurnRisk,s.LifetimeValue,s.PreferredChannel,CAST(GETDATE() AS DATE),&apos;9999-12-31&apos;,1,GETDATE(),&apos;SSIS&apos; FROM RETAIL_SRC.RETAIL_CUSTOMER s WHERE NOT EXISTS (SELECT 1 FROM DIM.DIM_CUSTOMER d WHERE d.CustomerID=s.CustomerID AND d.SourceSystem=&apos;RETAIL_DB&apos; AND d.IsCurrent=1);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\LOAD_FACT_TRANSACTION"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{08A43E0F-B9B3-4DD9-A364-E4DEBABDA2F1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="LOAD_FACT_TRANSACTION"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="INSERT INTO FACT.FACT_TRANSACTION (TransactionID,CustomerSK,BranchSK,TransactionDateSK,Amount,Currency,TransactionType,Channel,MerchantCategory,FraudFlag,FraudScore,Status,BalanceBefore,BalanceAfter,ETL_LOAD_DT,ETL_SOURCE) SELECT t.TransactionID,c.CustomerSK,b.BranchSK,dd.DateSK,t.Amount,t.Currency,t.TransactionType,t.Channel,t.MerchantCategory,t.FraudFlag,t.FraudScore,t.Status,t.BalanceBefore,t.BalanceAfter,GETDATE(),&apos;SSIS&apos; FROM RETAIL_SRC.RETAIL_TRANSACTION t INNER JOIN DIM.DIM_CUSTOMER c ON t.CustomerID=c.CustomerID AND c.IsCurrent=1 LEFT JOIN DIM.DIM_BRANCH b ON t.BranchID=b.BranchID LEFT JOIN DIM.DIM_DATE dd ON dd.DateSK=CAST(CONVERT(VARCHAR,t.TransactionDate,112) AS INT) WHERE NOT EXISTS (SELECT 1 FROM FACT.FACT_TRANSACTION f WHERE f.TransactionID=t.TransactionID)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DQ_TRANSACTIONS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{D4E5F6A7-B8C9-4D8E-1F2A-4B5C6D7E8F9A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DQ_TRANSACTIONS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_RAW_TO_STAGING&apos;,&apos;DQ_ZERO_AMOUNTS&apos;,GETDATE(),COUNT(*),CASE WHEN COUNT(*)&gt;0 THEN &apos;WARN_INVALID_AMOUNTS&apos; ELSE &apos;OK&apos; END FROM FACT.FACT_TRANSACTION WHERE Amount IS NULL OR Amount &lt;= 0;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\RECONCILE_COUNTS"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{E5F6A7B8-C9D0-4E9F-2A3B-5C6D7E8F9A0B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="RECONCILE_COUNTS"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,RowsProcessed,Status) SELECT CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_RAW_TO_STAGING&apos;,tbl,GETDATE(),cnt,&apos;OK&apos; FROM (SELECT &apos;DIM_CUSTOMER_RETAIL&apos; tbl,COUNT(*) cnt FROM DIM.DIM_CUSTOMER WHERE SourceSystem=&apos;RETAIL_DB&apos; UNION ALL SELECT &apos;FACT_TRANSACTION&apos;,COUNT(*) FROM FACT.FACT_TRANSACTION) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\AUDIT_END"
