      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{862CE8A5-04C1-4B6B-994F-B0B40232F116}"
          SQLTask:SqlStatementSource="IF OBJECT_ID(&apos;DW_AUDIT.ETL_BATCH_LOG&apos;,&apos;U&apos;) IS NOT NULL INSERT INTO DW_AUDIT.ETL_BATCH_LOG (BatchID,PackageName,StepName,StartTime,EndTime,Status) VALUES (CONVERT(VARCHAR,GETDATE(),112)+REPLACE(CONVERT(VARCHAR,GETDATE(),108),&apos;:&apos;,&apos;&apos;),&apos;RETAIL_DB_RAW_TO_STAGING&apos;,&apos;PACKAGE_END&apos;,GETDATE(),GETDATE(),&apos;COMPLETED&apos;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
