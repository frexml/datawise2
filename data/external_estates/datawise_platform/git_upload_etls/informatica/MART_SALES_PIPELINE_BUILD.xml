    <FOLDER NAME="MART_SALES_PIPELINE" OWNER="ETL_ADMIN" SHARED="SHARED"
            DESCRIPTION="Build MART_SALES_PIPELINE - active loan pipeline with cross-sell opportunities"
            PERMISSIONS="rwx---r--" UUID="f6a7b8c9-d0e1-2345-fabc-456789012345">

      <TRANSFORMATION NAME="SQ_SALES_PIPELINE" TYPE="Source Qualifier" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="
SELECT
  fl.ApplicationDateSK                                               AS DateSK,
  fl.BranchSK,
  fl.ProductSK,
  fl.CustomerSK,
  CASE WHEN fl.ApplicationStatus = 'Approved' AND fl.AccountStatus = 'Active' THEN 'ACTIVE_LOAN'
       WHEN fl.ApplicationStatus = 'Approved' THEN 'APPROVED_PENDING'
       WHEN fl.ApplicationStatus = 'Under Review' THEN 'UNDER_REVIEW'
       ELSE 'PROSPECT' END                                           AS OpportunityStage,
  ISNULL(fl.LoanAmount, 0)                                           AS PipelineValue,
  ISNULL(fl.ML_ApprovalScore, 0.5)                                   AS WinProbability,
  ISNULL(mc.CrossSellScore, 50)                                      AS CrossSellScore,
  ISNULL(mc.NextBestProduct, 'Personal Loan')                        AS NextBestProduct,
  NULL                                                               AS CampaignID,
  GETDATE()                                                          AS ETL_LOAD_DT
FROM FACT.FACT_LOAN fl
LEFT JOIN MART.MART_CUSTOMER_360 mc ON mc.CustomerSK = fl.CustomerSK
WHERE fl.ApplicationStatus IN ('Pending', 'Under Review', 'Approved')
   OR fl.AccountStatus = 'Active'"/>
        <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
      </TRANSFORMATION>

