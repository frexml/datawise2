      <!-- SOURCE QUALIFIER: join DIM_CUSTOMER + FACT_LOAN + FACT_TRANSACTION -->
      <TRANSFORMATION NAME="SQ_CUSTOMER_360" TYPE="Source Qualifier" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="
SELECT
  dc.CustomerSK,
  dc.CustomerID,
  dc.FullName,
  dc.Segment,
  dc.LoyaltyTier,
  dc.Region,
  dc.City,
  dc.AnnualIncome,
  dc.CreditScore,
  dc.CreditBand,
  dc.KYCStatus,
  dc.RelationshipScore,
  dc.ChurnRisk,
  dc.LifetimeValue,
  ISNULL(la.TotalLoans, 0)                                           AS TotalLoans,
  ISNULL(la.TotalLoanAmount, 0)                                      AS TotalLoanAmount,
  ISNULL(la.TotalOutstanding, 0)                                     AS TotalOutstanding,
  ISNULL(la.ActiveLoans, 0)                                          AS ActiveLoans,
  ISNULL(la.NPLCount, 0)                                             AS NPLCount,
  ISNULL(ta.TotalTransactions, 0)                                    AS TotalTransactions,
  ISNULL(ta.TotalSpend, 0)                                           AS TotalSpend,
  ISNULL(ta.AvgTransactionValue, 0)                                  AS AvgTransactionValue,
  ta.LastTransactionDate,
  ISNULL(ta.FraudAlerts, 0)                                          AS FraudAlerts,
  ISNULL(pa.TotalPayments, 0)                                        AS TotalPayments,
  ISNULL(pa.OnTimePayments, 0)                                       AS OnTimePayments,
  ISNULL(pa.LatePayments, 0)                                         AS LatePayments,
  ISNULL(la.MaxDPD, 0)                                               AS MaxDPD,
  ISNULL(la.TotalRWA, 0)                                             AS TotalRWA,
  ISNULL(la.TotalExpectedLoss, 0)                                    AS TotalExpectedLoss,
  CASE WHEN la.TotalLoans > 0 THEN 1 ELSE 0 END                      AS HasLoan,
  0                                                                  AS HasCurrentAccount,
  0                                                                  AS HasSavingsAccount,
  ISNULL(la.CrossSellScore, 50)                                      AS CrossSellScore,
  ISNULL(la.NextBestProduct, 'Personal Loan')                        AS NextBestProduct,
  GETDATE()                                                          AS ETL_LOAD_DT
FROM DIM.DIM_CUSTOMER dc
LEFT JOIN (
  SELECT CustomerSK,
    COUNT(LoanFactSK)                                                AS TotalLoans,
    SUM(ISNULL(LoanAmount,0))                                        AS TotalLoanAmount,
    SUM(ISNULL(OutstandingBalance,0))                                AS TotalOutstanding,
    SUM(CASE WHEN AccountStatus='Active' THEN 1 ELSE 0 END)          AS ActiveLoans,
    SUM(ISNULL(IsNPL,0))                                             AS NPLCount,
    MAX(ISNULL(DaysPastDue,0))                                       AS MaxDPD,
    SUM(ISNULL(RWA,0))                                               AS TotalRWA,
    SUM(ISNULL(ExpectedLoss,0))                                      AS TotalExpectedLoss,
    CAST(AVG(ISNULL(ML_ApprovalScore,0.5)) * 100 AS INT)             AS CrossSellScore,
    'Personal Loan'                                                  AS NextBestProduct
  FROM FACT.FACT_LOAN
  GROUP BY CustomerSK
) la ON la.CustomerSK = dc.CustomerSK
LEFT JOIN (
  SELECT CustomerSK,
    COUNT(TransactionSK)                                             AS TotalTransactions,
    SUM(ISNULL(Amount,0))                                            AS TotalSpend,
    AVG(ISNULL(Amount,0))                                            AS AvgTransactionValue,
    MAX(CAST(CONVERT(VARCHAR(8),TransactionDateSK) AS DATE))         AS LastTransactionDate,
    SUM(CASE WHEN FraudFlag='Y' THEN 1 ELSE 0 END)                   AS FraudAlerts
  FROM FACT.FACT_TRANSACTION
  GROUP BY CustomerSK
) ta ON ta.CustomerSK = dc.CustomerSK
LEFT JOIN (
  SELECT CustomerSK,
    COUNT(PaymentSK)                                                 AS TotalPayments,
    SUM(CASE WHEN ISNULL(IsLate,0)=0 THEN 1 ELSE 0 END)             AS OnTimePayments,
    SUM(CASE WHEN ISNULL(IsLate,0)=1 THEN 1 ELSE 0 END)             AS LatePayments,
    CAST(SUM(CASE WHEN ISNULL(IsLate,0)=0 THEN 1.0 ELSE 0 END)
         / NULLIF(COUNT(PaymentSK),0) AS FLOAT)                      AS PaymentReliabilityScore
  FROM FACT.FACT_PAYMENT
  GROUP BY CustomerSK
) pa ON pa.CustomerSK = dc.CustomerSK
WHERE dc.IsCurrent = 1"/>
        <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
      </TRANSFORMATION>

