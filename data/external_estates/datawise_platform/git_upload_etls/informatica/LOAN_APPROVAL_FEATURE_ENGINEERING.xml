      <!-- SOURCE QUALIFIER -->
      <TRANSFORMATION NAME="SQ_LOAN_CUSTOMER" TYPE="Source Qualifier" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="
SELECT
  fl.AccountID                                                       AS ApplicationID,
  fl.CustomerSK,
  dc.CreditScore,
  dc.CreditBand,
  ISNULL(fl.DaysPastDue, 0)                                          AS MaxDPD12Months,
  ISNULL(fl.DaysPastDue, 0)                                          AS MaxDPD24Months,
  ISNULL(dc.RelationshipScore, 50)                                   AS PaymentHistoryScore,
  ISNULL(fl.LTVRatio, 0)                                             AS UtilisationRatio,
  1                                                                  AS TotalFacilities,
  ISNULL(fl.IsNPL, 0)                                                AS NonPerformingFacilities,
  0                                                                  AS Bankruptcies,
  ISNULL(dc.AnnualIncome, 0)                                         AS AnnualIncome,
  ISNULL(fl.OutstandingBalance, 0)                                   AS ExistingDebt,
  ISNULL(fl.DTIRatio, 0)                                             AS DTIRatio,
  ISNULL(dc.YearsEmployed, 0)                                        AS YearsEmployed,
  ISNULL(dc.EmploymentStatus, 'Unknown')                             AS EmploymentStatus,
  ISNULL(dc.RelationshipScore, 50)                                   AS IncomeStabilityScore,
  ISNULL(fl.LoanAmount, 0)                                           AS LoanAmount,
  ISNULL(fl.TermMonths, 12)                                          AS LoanTermMonths,
  'General'                                                          AS LoanPurpose,
  ISNULL(fl.InterestRate, 0)                                         AS RequestedRate,
  'Real Estate'                                                      AS CollateralType,
  ISNULL(fl.CollateralValue, 0)                                      AS CollateralValue,
  ISNULL(fl.LTVRatio, 0)                                             AS LTVRatio,
  50                                                                 AS CollateralQualityScore,
  ISNULL(ta.TxnCount, 0)                                             AS TotalTransactions,
  ISNULL(ta.AvgBalance, 0)                                           AS AvgMonthlyBalance,
  ISNULL(ta.FraudCount, 0)                                           AS FraudAlerts,
  ISNULL(dc.RelationshipScore, 50)                                   AS RelationshipScore,
  ISNULL(dc.LoyaltyTier, 'Bronze')                                   AS LoyaltyTier,
  ISNULL(dc.ChurnRisk, 'Low')                                        AS ChurnRisk,
  10.0                                                               AS BaseRate,
  75                                                                 AS ProductRiskWeight,
  CASE WHEN fl.AccountStatus = 'Active' THEN 1 ELSE 0 END            AS ApprovalDecision,
  CAST(GETDATE() AS DATE)                                            AS FeatureExtractDate,
  'INFORMATICA'                                                      AS ETL_SOURCE
FROM FACT.FACT_LOAN fl
LEFT JOIN DIM.DIM_CUSTOMER dc ON dc.CustomerSK = fl.CustomerSK AND dc.IsCurrent = 1
LEFT JOIN (
  SELECT CustomerSK,
    COUNT(*) AS TxnCount,
    AVG(ISNULL(BalanceBefore, 0)) AS AvgBalance,
    SUM(CASE WHEN FraudFlag = 'Y' THEN 1 ELSE 0 END) AS FraudCount
  FROM FACT.FACT_TRANSACTION
  GROUP BY CustomerSK
) ta ON ta.CustomerSK = fl.CustomerSK"/>
        <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
      </TRANSFORMATION>

      <!-- EXPRESSION: derive ML features -->
      <TRANSFORMATION NAME="EXP_LOAN_FEATURES" TYPE="Expression" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TRANSFORMFIELD NAME="DebtToIncomeRatio"  DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="8" SCALE="4"
          EXPRESSION="IIF(ISNULL(AnnualIncome) OR AnnualIncome = 0, 0, (MonthlyInstalment * 12) / AnnualIncome)"/>
        <TRANSFORMFIELD NAME="LoanToIncomeRatio"  DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="8" SCALE="4"
          EXPRESSION="IIF(ISNULL(AnnualIncome) OR AnnualIncome = 0, 0, LoanAmount / AnnualIncome)"/>
        <TRANSFORMFIELD NAME="RiskScore"          DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="8" SCALE="4"
          EXPRESSION="(PD * LGD * 0.4) + (IIF(DaysPastDue > 90, 0.3, DaysPastDue / 300.0)) + (IIF(CreditScore = 0, 0.3, (850 - CreditScore) / 850.0) * 0.3)"/>
        <TRANSFORMFIELD NAME="ApprovalLabel"      DATATYPE="integer" PORTTYPE="OUTPUT" PRECISION="1" SCALE="0"
          EXPRESSION="IIF(ApplicationStatus = 'Approved' OR AccountStatus = 'Active', 1, 0)"/>
        <TRANSFORMFIELD NAME="FeatureExtractDate" DATATYPE="date"    PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
          EXPRESSION="TRUNC(SYSDATE)"/>
        <TRANSFORMFIELD NAME="BatchID"            DATATYPE="string"  PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"
          EXPRESSION="TO_CHAR(SYSDATE, 'YYYYMMDDHHMMSS')"/>
      </TRANSFORMATION>

