      <!-- SOURCE QUALIFIER -->
      <TRANSFORMATION NAME="SQ_TXN_CUSTOMER" TYPE="Source Qualifier" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TABLEATTRIBUTE NAME="Sql Query" VALUE="
SELECT
  ft.TransactionID,
  ft.CustomerSK,
  ISNULL(ft.Amount, 0)                                               AS Amount,
  ISNULL(ft.TransactionType, 'Unknown')                              AS TransactionType,
  ISNULL(ft.Channel, 'Unknown')                                      AS Channel,
  ISNULL(ft.MerchantCategory, 'Unknown')                             AS MerchantCategory,
  DATEPART(HOUR, GETDATE())                                          AS TransactionHour,
  CASE WHEN DATEPART(WEEKDAY, GETDATE()) IN (1,7) THEN 1 ELSE 0 END  AS IsWeekend,
  ISNULL(vel.TxnCount24h, 1)                                         AS TxnCount24h,
  ISNULL(vel.TxnAmount24h, ft.Amount)                                AS TxnAmount24h,
  ISNULL(vel.TxnCount7d, 1)                                          AS TxnCount7d,
  ISNULL(vel.TxnAmount7d, ft.Amount)                                 AS TxnAmount7d,
  ISNULL(vel.AvgTxnAmount30d, ft.Amount)                             AS AvgTxnAmount30d,
  ISNULL(vel.AmountDeviationScore, 0)                                AS AmountDeviationScore,
  CAST(0 AS BIT)                                                     AS NewMerchantFlag,
  CAST(0 AS BIT)                                                     AS NewChannelFlag,
  ISNULL(dc.CreditScore, 600)                                        AS CustomerCreditScore,
  ISNULL(dc.ChurnRisk, 'Low')                                        AS CustomerChurnRisk,
  CASE WHEN ft.FraudFlag = 'Y' THEN 1 ELSE 0 END                    AS FraudLabel,
  CAST(GETDATE() AS DATE)                                            AS FeatureExtractDate,
  'INFORMATICA'                                                      AS ETL_SOURCE
FROM FACT.FACT_TRANSACTION ft
LEFT JOIN DIM.DIM_CUSTOMER dc ON dc.CustomerSK = ft.CustomerSK AND dc.IsCurrent = 1
LEFT JOIN (
  SELECT CustomerSK,
    COUNT(*) AS TxnCount24h,
    SUM(ISNULL(Amount,0)) AS TxnAmount24h,
    COUNT(*) AS TxnCount7d,
    SUM(ISNULL(Amount,0)) AS TxnAmount7d,
    AVG(ISNULL(Amount,0)) AS AvgTxnAmount30d,
    (MAX(ISNULL(Amount,0)) - AVG(ISNULL(Amount,0))) / NULLIF(AVG(ISNULL(Amount,0)),0) AS AmountDeviationScore
  FROM FACT.FACT_TRANSACTION
  GROUP BY CustomerSK
) vel ON vel.CustomerSK = ft.CustomerSK"/>
        <TABLEATTRIBUTE NAME="Source Filter" VALUE=""/>
      </TRANSFORMATION>

      <!-- EXPRESSION: derive fraud features -->
      <TRANSFORMATION NAME="EXP_TXN_FEATURES" TYPE="Expression" REUSABLE="NO" OBJECTVERSION="1" VERSIONNUMBER="1">
        <TRANSFORMFIELD NAME="AmountToIncomeRatio"  DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="8" SCALE="4"
          EXPRESSION="IIF(ISNULL(AnnualIncome) OR AnnualIncome = 0, 0, Amount / (AnnualIncome / 12.0))"/>
        <TRANSFORMFIELD NAME="BalanceChangeRatio"   DATATYPE="decimal" PORTTYPE="OUTPUT" PRECISION="8" SCALE="4"
          EXPRESSION="IIF(ISNULL(BalanceBefore) OR BalanceBefore = 0, 0, ABS(BalanceChange) / ABS(BalanceBefore))"/>
        <TRANSFORMFIELD NAME="IsUnusualChannel"     DATATYPE="integer" PORTTYPE="OUTPUT" PRECISION="1" SCALE="0"
          EXPRESSION="IIF(Channel != PreferredChannel AND NOT ISNULL(PreferredChannel), 1, 0)"/>
        <TRANSFORMFIELD NAME="FraudLabel"           DATATYPE="integer" PORTTYPE="OUTPUT" PRECISION="1" SCALE="0"
          EXPRESSION="IIF(FraudFlag = 'Y', 1, 0)"/>
        <TRANSFORMFIELD NAME="FeatureExtractDate"   DATATYPE="date"    PORTTYPE="OUTPUT" PRECISION="10" SCALE="0"
          EXPRESSION="TRUNC(SYSDATE)"/>
        <TRANSFORMFIELD NAME="BatchID"              DATATYPE="string"  PORTTYPE="OUTPUT" PRECISION="50" SCALE="0"
          EXPRESSION="TO_CHAR(SYSDATE, 'YYYYMMDDHHMMSS')"/>
      </TRANSFORMATION>

